# --- Apple account used ONLY by the server to authenticate against Apple ---
# Use a SECONDARY / burner Apple ID, never your personal one.
# The AirTag decryption keys are independent of this account (they come from
# the .plist extracted on your Mac), so a burner works perfectly.
APPLE_ID=
APPLE_PASSWORD=

# DIY / Flipper tag: base64 private key from scripts/generate-key.py (or FindMyFlipper).
# This is the primary path. Leave empty only if using a real AirTag accessory instead.
AIRTAG_PRIVATE_KEY=

# Self-hosted anisette server (runs as its own container on media-network).
ANISETTE_URL=http://anisette:6969

# How often to poll Apple for new location reports (seconds).
POLL_INTERVAL=900

# Timezone for display.
TZ=Europe/Madrid
